    "request": {
      "method": "initialize",
      "params": {
        "protocolVersion": "2025-06-18",
        "capabilities": {},
        "clientInfo": {
          "name": "provider-agent",
          "version": "1.0"
        }
      }
    },
    "status": 200,
    "response": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "protocolVersion": "2025-06-18",
        "capabilities": {
          "tools": {
            "listChanged": false
          }
        },
        "serverInfo": {
          "name": "paysettle",
          "title": "PaySettle milestone contracts",
          "version": "0.1.0"
        },
        "instructions": "PaySettle holds a client's money through PayPal and releases it milestone by milestone. You act for the person who minted your token. You can draft and negotiate workspaces, read status, request funding (the buyer approves in PayPal), submit evidence notes and links, ask for a release (the client confirms in the app) and open disputes. You cannot sign, approve or move money yourself."
      }
    }
  },
