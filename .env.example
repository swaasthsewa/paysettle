# PaySettle environment. Copy to .env.local for local runs.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/paysettle
# sandbox | production (production refuses demo sign-in, time travel, rail A2)
PAYSETTLE_ENV=sandbox
# PayPal Sandbox app (developer.paypal.com → Apps & Credentials → Sandbox). Without these, the MOCK rail is used.
APP_URL=http://localhost:3000
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# A1 payee routing · A2 platform merchant (sandbox only) · B delayed disbursement
PAYPAL_RAIL=A1
PAYPAL_WEBHOOK_ID=
PAYPAL_PROVIDER1_EMAIL=
PAYPAL_PROVIDER2_EMAIL=
# AI gateway (Claude by default). Without a key, AI surfaces say "AI unavailable" and rule-based checks still run.
AI_BASE_URL=https://api.anthropic.com
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_TOKEN_CAP=200000
# production auth for /api/cron/tick (header x-cron-secret)
CRON_SECRET=
SIGNING_KEY=
# AI options: anthropic | openai
AI_PROTOCOL=anthropic
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=2000
AI_PRICE_IN_PER_MTOK=3
AI_PRICE_OUT_PER_MTOK=15
COMPLIANCE_SIGNING_KEY=
# Staff SSO (OIDC). Without OIDC_ISSUER: built-in demo IdP in sandbox, no SSO in production.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ROLE_CLAIM=groups
OIDC_ROLE_MAP={"ps-ops":"ops","ps-mediator":"mediator","ps-finance":"finance","ps-admin":"admin"}
# optional: GitHub CI oracle for private repos / higher rate limit
GITHUB_TOKEN=
